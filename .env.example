# Sao chép file này thành .env rồi điền giá trị thật (không commit .env).
# Lấy URL/publishable key tại: Supabase Dashboard > Project Settings > API
# Hoặc chạy `npx supabase start` (cần Docker) để dùng project local — CLI sẽ in ra URL/key tương ứng.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Bản đồ Goong.io (goong.io > API Keys > tạo "API Key" loại REST). Dùng cho gợi
# ý địa chỉ + tính khoảng cách. Bỏ trống thì app vẫn chạy (ô địa chỉ gõ tay,
# giá tính theo ước lượng đường chim bay).
VITE_GOONG_API_KEY=

# Goong Maptiles Key (goong.io > Keys > Tạo Key > loại Maptiles) — KHÁC với API
# Key ở trên. Dùng cho bản đồ tương tác (Goong JS SDK). Bỏ trống thì app rơi về
# ảnh bản đồ tĩnh, các chức năng khác vẫn chạy.
VITE_GOONG_MAPTILES_KEY=

# Public key VAPID cho Web Push (tạo bằng `npx web-push generate-vapid-keys`).
# Private key KHÔNG đặt ở đây — set làm secret cho Edge Function send-push
# bằng `supabase secrets set VAPID_PRIVATE_KEY=...` (xem
# supabase/functions/send-push/README.md). Bỏ trống thì nút "Bật thông báo
# đẩy" tự ẩn, các thông báo trong app (Realtime) vẫn hoạt động bình thường.
VITE_VAPID_PUBLIC_KEY=
