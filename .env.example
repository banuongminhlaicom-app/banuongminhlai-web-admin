# Sao chép file này thành .env rồi điền giá trị thật (không commit .env).
# Lấy URL/publishable key tại: Supabase Dashboard > Project Settings > API
# Hoặc chạy `npx supabase start` (cần Docker) để dùng project local — CLI sẽ in ra URL/key tương ứng.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
