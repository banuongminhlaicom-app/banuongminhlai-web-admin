# Sao chép file này thành .env rồi điền giá trị thật (không commit .env).
# Lấy URL/publishable key tại: Supabase Dashboard > Project Settings > API
# Hoặc chạy `npx supabase start` (cần Docker) để dùng project local — CLI sẽ in ra URL/key tương ứng.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Bản đồ Goong.io (goong.io > API Keys > tạo "API Key" loại REST). Dùng cho gợi
# ý địa chỉ + tính khoảng cách. Bỏ trống thì app vẫn chạy (ô địa chỉ gõ tay,
# giá tính theo ước lượng đường chim bay).
VITE_GOONG_API_KEY=
